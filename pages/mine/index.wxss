.mine-page {
  padding: 32rpx;
}

.hero {
  padding: 50rpx 40rpx;
  margin-bottom: 34rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 4rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}
.mode-badge {
  display: inline-flex;
  margin-top: 26rpx;
  background: #FDF6E7;
  color: #A07A2C;
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 8rpx 18rpx;
}
.mode-badge.on {
  background: #E8F5EE;
  color: var(--positive);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 0 8rpx 18rpx;
  letter-spacing: 1rpx;
}

.summary {
  display: flex;
  align-items: center;
  padding: 34rpx 0;
  margin-bottom: 34rpx;
}
.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}
.summary-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.summary-div {
  width: 2rpx;
  height: 48rpx;
  background: var(--hairline);
}

.cells {
  padding: 0 28rpx;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--hairline);
}
.cell:last-child {
  border-bottom: none;
}
.cell-title {
  font-size: 30rpx;
  color: var(--text-primary);
}
.cell-title.danger {
  color: var(--danger);
}
.cell-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 50rpx;
}
