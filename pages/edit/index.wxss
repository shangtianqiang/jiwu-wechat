.edit-page {
  padding: 32rpx 32rpx 80rpx;
}

.form {
  padding: 10rpx 32rpx;
  margin-top: 10rpx;
}

.field {
  padding: 30rpx 0;
}
.field-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.field-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.field-inline .field-label {
  margin-bottom: 0;
}
.req {
  color: var(--danger);
}
.field-input {
  font-size: 32rpx;
  color: var(--text-primary);
  width: 100%;
}
.input-placeholder {
  color: var(--text-tertiary);
}
.field-textarea {
  font-size: 30rpx;
  color: var(--text-primary);
  width: 100%;
  min-height: 100rpx;
  line-height: 1.6;
}

/* ===== 图片选择 ===== */
.img-scroll {
  width: 100%;
  white-space: nowrap;
}
.img-cell {
  position: relative;
  display: inline-flex;
  width: 128rpx;
  height: 128rpx;
  margin-right: 18rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  vertical-align: top;
}
.img-cell.sel {
  border-color: var(--accent);
}
.img-thumb {
  width: 100%;
  height: 100%;
}
.img-thumb.contain {
  padding: 14rpx;
  box-sizing: border-box;
}
.upload-cell {
  flex-direction: column;
  border: 2rpx dashed #C9CDD4;
  background: #FFFFFF;
}
.upload-cell.uploading {
  opacity: 0.5;
}
.upload-icon {
  font-size: 40rpx;
  line-height: 1.2;
}
.upload-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.img-clear {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 16rpx;
}

/* 分类 chips */
.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 6rpx;
}
.custom-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}
.custom-input {
  flex: 1;
  background: var(--bg-sub);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-right: 16rpx;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: var(--bg-sub);
  color: var(--text-primary);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-input {
  width: 110rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 时间选择 */
.time-pickers {
  display: flex;
  gap: 14rpx;
}

/* 底部按钮 */
.save-btn {
  margin-top: 50rpx;
}
.delete-btn {
  margin-top: 24rpx;
}
