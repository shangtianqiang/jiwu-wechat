.list-page {
  padding: 0 32rpx 40rpx;
}

/* ===== 顶部 ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 36rpx 8rpx 30rpx;
}
.header-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.header-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 4rpx;
}
.header-add {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 17, 17, 0.18);
}

/* ===== 汇总卡 ===== */
.summary {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  margin-bottom: 24rpx;
}
.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}
.summary-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.summary-div {
  width: 2rpx;
  height: 48rpx;
  background: var(--hairline);
}

/* ===== 本机模式提示 ===== */
.notice {
  background: #FDF6E7;
  color: #A07A2C;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  margin-bottom: 20rpx;
}

/* ===== 搜索 ===== */
.toolbar {
  margin-bottom: 26rpx;
}
.search {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 18rpx 26rpx;
  box-shadow: var(--shadow);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}
.search-placeholder {
  color: var(--text-tertiary);
}
.search-clear {
  color: var(--text-tertiary);
  font-size: 28rpx;
  padding: 0 8rpx;
}

/* ===== 分组 ===== */
.group {
  margin-bottom: 30rpx;
}
.group-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 6rpx 8rpx 16rpx;
}
.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}
.group-count {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 物品卡片 ===== */
.item-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}
.item-img {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.row-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.row-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.row-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-qty {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-sub);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}
.row-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-note {
  color: var(--text-tertiary);
}
.row-sep {
  margin: 0 10rpx;
  color: var(--text-tertiary);
}
.row-date {
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 6rpx;
}

/* ===== 空状态 ===== */
.empty {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}
.empty-icon {
  font-size: 88rpx;
  margin-bottom: 30rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.empty-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}
