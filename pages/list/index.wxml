<view class="page-bg list-page">
  <!-- 顶部：日期 + 标题 + 添加 -->
  <view class="header">
    <view>
      <view class="header-date">{{header.date}} {{header.weekday}}</view>
      <view class="header-title">物记</view>
    </view>
    <view class="header-add" bindtap="onAdd">＋</view>
  </view>

  <!-- 汇总卡 -->
  <view class="summary card">
    <view class="summary-item">
      <view class="summary-num">{{kinds}}</view>
      <view class="summary-label">物品种类</view>
    </view>
    <view class="summary-div"></view>
    <view class="summary-item">
      <view class="summary-num">{{pieces}}</view>
      <view class="summary-label">总件数</view>
    </view>
    <view class="summary-div"></view>
    <view class="summary-item">
      <view class="summary-num">{{categoryCount}}</view>
      <view class="summary-label">分类</view>
    </view>
  </view>

  <!-- 本机模式提示 -->
  <view class="notice" wx:if="{{!cloudReady}}">本机模式 · 数据暂存这台设备，云端数据库恢复后自动上云</view>

  <!-- 搜索 -->
  <view class="toolbar">
    <view class="search">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索名称 / 位置 / 备注" placeholder-class="search-placeholder"
             value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 分类分组列表 -->
  <view class="list">
    <block wx:if="{{groups.length > 0}}">
      <view class="group" wx:for="{{groups}}" wx:for-item="group" wx:key="name">
        <view class="group-head">
          <view class="group-name">{{group.name}}</view>
          <view class="group-count">{{group.count}} 件</view>
        </view>
        <view class="item-row card" wx:for="{{group.items}}" wx:key="id"
              bindtap="onItemTap" bindlongpress="onItemLongPress"
              data-id="{{item.id}}">
          <image class="item-img img-tile" src="{{item.img}}" mode="aspectFill" lazy-load />
          <view class="row-main">
            <view class="row-top">
              <text class="row-name">{{item.name}}</text>
              <text class="row-qty" wx:if="{{item.quantity > 1}}">×{{item.quantity}}</text>
            </view>
            <view class="row-sub" wx:if="{{item.location || item.note}}">
              <text wx:if="{{item.location}}">{{item.location}}</text>
              <text wx:if="{{item.location && item.note}}" class="row-sep">·</text>
              <text wx:if="{{item.note}}" class="row-note">{{item.note}}</text>
            </view>
          </view>
          <view class="row-date">{{item.dateLabel}}</view>
        </view>
      </view>
    </block>

    <block wx:elif="{{!loading}}">
      <view class="empty card" wx:if="{{!loadError}}">
        <view class="empty-icon">📦</view>
        <view class="empty-title">{{keyword ? '没有找到相关物品' : '还没有记录'}}</view>
        <view class="empty-subtitle">{{keyword ? '换个关键词试试' : '点右上角 ＋ 记录你的第一件物品'}}</view>
      </view>
      <view class="empty card" wx:else>
        <view class="empty-icon">⚠️</view>
        <view class="empty-title">加载失败</view>
        <view class="empty-subtitle">{{loadError}}</view>
      </view>
    </block>
  </view>
</view>
