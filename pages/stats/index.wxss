.stats-page {
  padding: 32rpx;
}

.summary {
  display: flex;
  align-items: center;
  padding: 34rpx 0;
  margin-bottom: 34rpx;
}
.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}
.summary-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.summary-div {
  width: 2rpx;
  height: 48rpx;
  background: var(--hairline);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 0 8rpx 18rpx;
  letter-spacing: 1rpx;
}

.dist {
  padding: 14rpx 28rpx;
}
.dist-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--hairline);
}
.dist-row:last-child {
  border-bottom: none;
}
.dist-name {
  width: 150rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dist-bar-wrap {
  flex: 1;
  height: 20rpx;
  background: var(--bg-sub);
  border-radius: 10rpx;
  margin: 0 20rpx;
  overflow: hidden;
}
.dist-bar {
  height: 100%;
  background: var(--accent);
  border-radius: 10rpx;
  min-width: 8rpx;
}
.dist-count {
  width: 90rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.empty {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  font-size: 88rpx;
  margin-bottom: 30rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.empty-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}
