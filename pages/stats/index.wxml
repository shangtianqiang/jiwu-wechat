<view class="page-bg stats-page">
  <!-- 汇总卡 -->
  <view class="summary card">
    <view class="summary-item">
      <view class="summary-num">{{kinds}}</view>
      <view class="summary-label">物品种类</view>
    </view>
    <view class="summary-div"></view>
    <view class="summary-item">
      <view class="summary-num">{{pieces}}</view>
      <view class="summary-label">总件数</view>
    </view>
    <view class="summary-div"></view>
    <view class="summary-item">
      <view class="summary-num">{{recentCount}}</view>
      <view class="summary-label">近7天录入</view>
    </view>
  </view>

  <!-- 分类分布 -->
  <view class="section-title">分类分布</view>
  <view class="dist card" wx:if="{{distribution.length > 0}}">
    <view class="dist-row" wx:for="{{distribution}}" wx:key="name">
      <view class="dist-name">{{item.name}}</view>
      <view class="dist-bar-wrap">
        <view class="dist-bar" style="width: {{item.pct}}%"></view>
      </view>
      <view class="dist-count">{{item.count}} 件</view>
    </view>
  </view>
  <view class="empty card" wx:elif="{{!loading && !loadError}}">
    <view class="empty-icon">📊</view>
    <view class="empty-title">暂无统计数据</view>
    <view class="empty-subtitle">先去首页添加物品吧</view>
  </view>
  <view class="empty card" wx:elif="{{loadError}}">
    <view class="empty-icon">⚠️</view>
    <view class="empty-title">加载失败</view>
    <view class="empty-subtitle">{{loadError}}</view>
  </view>
</view>
